              "value": "{\"keyword\": \"iPhone 15\", \"maxItems\": 10, \"detailLevel\": \"full\", \"proxyConfiguration\": {\"useApifyProxy\": true, \"apifyProxyGroups\": [\"RESIDENTIAL\"], \"apifyProxyCountry\": \"HK\"}}",
